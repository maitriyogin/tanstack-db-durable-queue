{
  "name": "tanstack-db-durable-queue",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "bff-todos",
    "fe-todos",
    "fe-todos-legend",
    "fe-todos-expo"
  ],
  "scripts": {
    "dev": "concurrently --names bff,fe,legend --prefix-colors blue,green,magenta \"bun run dev:bff\" \"bun run dev:fe\" \"bun run dev:legend\"",
    "dev:bff": "bun run --cwd bff-todos dev",
    "dev:fe": "bun run --cwd fe-todos dev",
    "dev:legend": "bun run --cwd fe-todos-legend dev",
    "dev:expo": "bun run --cwd fe-todos-expo start",
    "build:fe": "bun run --cwd fe-todos build",
    "build:bff": "bun run --cwd bff-todos build",
    "build:legend": "bun run --cwd fe-todos-legend build",
    "test": "bun run --cwd fe-todos test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.2.1"
  }
}