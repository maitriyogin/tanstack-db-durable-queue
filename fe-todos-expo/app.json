{
  "expo": {
    "name": "fe-todos-expo",
    "slug": "fe-todos-expo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fetodosexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
